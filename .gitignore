# --- secrets / credentials -- never committed under any name ---------------
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
token*.json
oauth*.json
*cookie*
*session*.json
service-account*.json
*.p12
*.pfx

# --- python -----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- local runtime state / logs ---------------------------------------------
logs/
tmp/
.cache/
data/runtime/

# --- real prospect / outreach runtime data ----------------------------------
# Everything under these paths is generated by running the pipeline against
# real businesses: real names, real emails, real phone numbers, real send/
# reply/bounce history. None of it belongs in version control. Directory
# structure is preserved via .gitkeep; safe synthetic examples live in
# data/fixtures/ instead (see CLAUDE.md).
data/leads/*
!data/leads/.gitkeep
data/prospects/*
!data/prospects/.gitkeep
data/markets/*
!data/markets/.gitkeep
data/rankings/*
!data/rankings/.gitkeep
data/outreach/*
!data/outreach/.gitkeep

# V3.6 shared handoff queue + monthly-tracker CSV exports -- same real-data
# rationale as data/outreach/ above. Never committed, never public-link
# shared. Google Sheets service-account credential files are already
# covered above (credentials*.json / token*.json / service-account*.json)
# regardless of where they're placed.
data/handoff/*
!data/handoff/.gitkeep

# dated runtime reports (generated by report_pipeline.py / triage_report.py
# against real run data) -- named phase-documentation reports (V1..V3.3,
# RED-TEAM-REVIEW, OPERATING-RULES-V3, cost reviews) are NOT matched by
# these patterns and remain tracked.
reports/report-*.md
reports/triage-*.md
